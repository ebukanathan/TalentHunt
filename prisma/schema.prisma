// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompetitionStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  COMPLETED
}

enum LeaderboardVisibility {
  LIVE
  RANK_ONLY
  HIDDEN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentInitializationState {
  STARTED
  READY
  REJECTED
  UNKNOWN
}

model Competition {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  description  String?
  status       CompetitionStatus @default(DRAFT)
  votingOpens  DateTime?
  votingCloses DateTime?
  currency     String            @default("NGN")
  leaderboardVisibility LeaderboardVisibility @default(HIDDEN)
  resultsPublishedAt DateTime?
  // NULL until an administrator reviews the category rollout (CAT-03).
  categorySetupCompletedAt DateTime?

  categories  Category[]
  contestants Contestant[]
  packages    VotePackage[]
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name          String      @db.VarChar(120)
  // Maintained by the migration's normalization trigger, including raw SQL writes.
  nameKey       String      @default("") @db.VarChar(120)
  slug          String      @db.VarChar(120)
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)
  revision      Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  subcategories Subcategory[]

  @@unique([competitionId, id])
  @@unique([competitionId, nameKey])
  @@unique([competitionId, slug])
  @@index([competitionId, isActive, sortOrder, id])
}

model Subcategory {
  id            String   @id @default(cuid())
  competitionId String
  categoryId    String
  category      Category @relation(fields: [competitionId, categoryId], references: [competitionId, id], onDelete: Restrict, onUpdate: Restrict)
  name          String   @db.VarChar(120)
  // The database owns this key; callers need only supply a display name.
  nameKey       String   @default("") @db.VarChar(120)
  slug          String   @db.VarChar(120)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  revision      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contestants Contestant[]

  @@unique([competitionId, categoryId, id])
  @@unique([competitionId, categoryId, nameKey])
  @@unique([competitionId, categoryId, slug])
  @@index([competitionId, categoryId, isActive, sortOrder, id])
}

model Contestant {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  // Expansion phase: legacy rows stay unassigned; CAT-03 gates NOT NULL.
  categoryId    String?
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [competitionId, categoryId, subcategoryId], references: [competitionId, categoryId, id], onDelete: Restrict, onUpdate: Restrict)
  assignmentRevision Int    @default(1)

  number     String
  name       String
  slug       String
  bio        String?
  imageUrl   String?
  isActive   Boolean @default(true)
  totalVotes BigInt  @default(0)

  payments    Payment[]
  allocations VoteAllocation[]
  videos      ContestantVideo[]
  paymentScopes PaymentScope[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, number])
  @@unique([competitionId, slug])
  @@index([competitionId, totalVotes])
  @@unique([competitionId, categoryId, subcategoryId, id], map: "Contestant_scope_identity_key")
  @@index([competitionId, categoryId, subcategoryId, isActive, totalVotes(sort: Desc), number, id], map: "Contestant_scoped_ranking_idx")
}

// Positions are constrained to 1 or 2 by the additive SQL migration.
model ContestantVideo {
  id             String     @id @default(cuid())
  contestantId   String
  contestant     Contestant @relation(fields: [contestantId], references: [id], onDelete: Cascade)
  youtubeVideoId String     @db.VarChar(11)
  position       Int
  createdAt      DateTime   @default(now())

  @@unique([contestantId, position])
  @@unique([contestantId, youtubeVideoId])
}

model VotePackage {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)

  name      String
  voteCount Int
  priceKobo Int
  currency  String  @default("NGN")
  isActive  Boolean @default(true)

  payments Payment[]
  paymentScopes PaymentScope[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId, isActive])
  @@unique([competitionId, id])
}

model ContactVerification {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  attempts   Int       @default(0)

  payment Payment?

  createdAt DateTime @default(now())

  @@index([email, expiresAt])
}

model Payment {
  id        String @id @default(cuid())
  reference String @unique

  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)

  contestantId String
  contestant   Contestant @relation(fields: [contestantId], references: [id], onDelete: Restrict)

  packageId String
  package   VotePackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  verificationId String?              @unique
  verification   ContactVerification? @relation(fields: [verificationId], references: [id], onDelete: Restrict)

  contactEmail  String
  amountKobo    Int
  voteCount     Int
  currency      String        @default("NGN")
  status        PaymentStatus @default(PENDING)
  providerTxnId String?       @unique
  paidAt        DateTime?
  refundedAt    DateTime?

  allocation     VoteAllocation?
  initialization PaymentInitialization?
  scope          PaymentScope?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([competitionId, createdAt])
  @@index([contestantId, status])
  @@unique([id, competitionId, contestantId, packageId], map: "Payment_scope_identity_key")
}

// Empty during expansion. CAT-03 captures new scopes atomically at reservation;
// no historical Payment is backfilled with an inferred category.
model PaymentScope {
  paymentId     String   @id
  competitionId String
  categoryId    String
  subcategoryId String
  contestantId  String
  packageId     String
  createdAt     DateTime @default(now())

  payment    Payment     @relation(fields: [paymentId, competitionId, contestantId, packageId], references: [id, competitionId, contestantId, packageId], onDelete: Restrict, onUpdate: Restrict, map: "PaymentScope_payment_fkey")
  contestant Contestant  @relation(fields: [competitionId, categoryId, subcategoryId, contestantId], references: [competitionId, categoryId, subcategoryId, id], onDelete: Restrict, onUpdate: Restrict, map: "PaymentScope_contestant_fkey")
  package    VotePackage @relation(fields: [competitionId, packageId], references: [competitionId, id], onDelete: Restrict, onUpdate: Restrict, map: "PaymentScope_package_fkey")

  @@unique([paymentId, competitionId, contestantId, packageId], map: "PaymentScope_payment_identity_key")
  @@index([competitionId, categoryId, subcategoryId, contestantId], map: "PaymentScope_assignment_idx")
  @@index([competitionId, packageId])
}

// One permanent retry capability and at most one provider dispatch per payment.
// No legacy payments are backfilled; an unknown outcome requires reconciliation.
model PaymentInitialization {
  idempotencyKeyHash String                     @id
  requestHash        String
  paymentId          String                     @unique
  payment            Payment                    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  state              PaymentInitializationState @default(STARTED)
  authorizationUrl   String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
}

model VoteAllocation {
  id        String  @id @default(cuid())
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  contestantId String
  contestant   Contestant @relation(fields: [contestantId], references: [id], onDelete: Restrict)

  voteCount Int

  createdAt DateTime @default(now())

  @@index([contestantId, createdAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  auditLogs AuditLog[]
  sessions  AdminSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminSession {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  adminId           String
  admin             AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?

  @@index([adminId])
  @@index([absoluteExpiresAt])
}

model AdminAuthRateLimit {
  keyHash   String   @id
  attempts  Int
  expiresAt DateTime

  @@index([expiresAt])
}

model AuditLog {
  id      String     @id @default(cuid())
  adminId String?
  admin   AdminUser? @relation(fields: [adminId], references: [id], onDelete: Restrict)

  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
}

// Storage journal contains metadata only; pending objects are quarantined for 24h.
// No FK cascade: cleanup metadata must survive a missing contestant.
model ContestantImageOperation {
  id            String   @id @default(cuid())
  contestantId  String
  objectKey     String   @unique
  imageUrl      String   @unique
  previousUrl   String?
  state         String   @default("PENDING")
  attempts      Int      @default(0)
  nextAttemptAt DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([state, nextAttemptAt])
  @@index([contestantId])
}
