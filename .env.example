# Copy to .env in the repository root. Never commit real credentials.
# Prisma CLI loads this root file through prisma.config.ts.
# Use an isolated development PostgreSQL/Supabase database.
DATABASE_URL=

# The current API defaults to port 4000. Runtime env validation is tracked by F05.
PORT=4000

# Explicit, LOCAL-ONLY seed target; no fallback to DATABASE_URL.
# SEED_ENV must be development or test. Keep URLs/credentials in .env only.
SEED_ENV=
SEED_DATABASE_URL=

# Integration tests require a fresh migrated local database named talenthunt_seed_test[_suffix].
SEED_TEST_DATABASE_URL=
