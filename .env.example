# Copy to .env in the repository root. Never commit real credentials.
# Prisma CLI loads this root file through prisma.config.ts.
# Use an isolated development PostgreSQL/Supabase database.
DATABASE_URL=

# The current API defaults to port 4000. Runtime env validation is tracked by F05.
PORT=4000

# Explicit development/test seed target; no fallback to DATABASE_URL.
# SEED_ENV must be development or test. Keep URLs/credentials in .env only.
SEED_ENV=
SEED_DATABASE_URL=

# Required only for a confirmed DEVELOPMENT/TEST Supabase project. Clear before production.
SEED_SUPABASE_PROJECT_REF=

# Integration tests require a fresh migrated local database named talenthunt_seed_test[_suffix].
SEED_TEST_DATABASE_URL=

# Public REST API: optional competition slug; empty selects the newest competition.
PUBLIC_COMPETITION_SLUG=

# API integration tests: FRESH migrated localhost talenthunt_api_test[_suffix] database only.
API_TEST_DATABASE_URL=

# PAY-01 is test-only. Leave all four blank to keep checkout disabled.
# Set PAYSTACK_MODE=test and supply your own sk_test_... key locally; live keys are rejected.
PAYSTACK_MODE=
PAYSTACK_SECRET_KEY=
# Fixed server-owned callback, e.g. http://localhost:3000/ (no receipt/status UI yet).
# HTTPS is required outside local development; do not put email or secrets in URLs.
PAYSTACK_CALLBACK_URL=
PAYSTACK_TIMEOUT_MS=

# Integration tests: FRESH migrated localhost talenthunt_payments_test[_suffix] only.
PAYMENTS_TEST_DATABASE_URL=

# ADMIN-01: blank disables admin; partial configuration fails startup safely.
# Production requires an HTTPS origin without a trailing slash.
ADMIN_AUTH_ENABLED=
ADMIN_APP_ORIGIN=
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_CSRF_SECRET=
ADMIN_IDLE_MINUTES=
ADMIN_ABSOLUTE_HOURS=
# Provisioning reads these from the PROCESS only, never DATABASE_URL/.env.
ADMIN_PROVISION_DATABASE_URL=
ADMIN_PROVISION_CONFIRM=
# FRESH migrated localhost talenthunt_admin_test[_suffix] database only.
ADMIN_TEST_DATABASE_URL=
ADMIN_WEB_TEST_DATABASE_URL=
ADMIN_CONTESTANTS_TEST_DATABASE_URL=
