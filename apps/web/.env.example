# Server-only Express API base URL. Set explicitly in deployment.
API_BASE_URL=http://localhost:4000/api/v1
# Same origin users visit, no trailing slash; HTTPS in production.
# Must match API ADMIN_APP_ORIGIN. Development default: http://localhost:3000
ADMIN_APP_ORIGIN=
# Public build-time origin for managed contestant portraits, e.g. https://project.supabase.co
# Origin only. Never put a storage secret or service-role key in NEXT_PUBLIC_* variables.
# Unset: safe legacy HTTPS portraits load directly in the browser without server optimisation.
NEXT_PUBLIC_CONTESTANT_IMAGE_ORIGIN=
