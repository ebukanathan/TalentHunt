# Server-only Express API base URL. Set explicitly in deployment.
API_BASE_URL=http://localhost:4000/api/v1
# Same origin users visit, no trailing slash; HTTPS in production.
# Must match API ADMIN_APP_ORIGIN. Development default: http://localhost:3000
ADMIN_APP_ORIGIN=
# Public build-time origin for managed contestant portraits, e.g. https://project.supabase.co
# Origin only. Never put a storage secret or service-role key in NEXT_PUBLIC_* variables.
# Unset: safe legacy HTTPS portraits load directly in the browser without server optimisation.
NEXT_PUBLIC_CONTESTANT_IMAGE_ORIGIN=
# Trusted public canonical origin, e.g. https://talenthunt.example (no path/query).
# Required for production indexing, canonical links, sharing URLs and sitemap entries.
# Unset/invalid: public metadata is noindex and robots disallows indexing.
SITE_URL=

# TEST MODE ONLY. Disabled unless explicitly true; no NEXT_PUBLIC payment credentials.
# Backend must separately use sk_test_* and a non-production database.
CHECKOUT_TEST_ENABLED=false
CHECKOUT_APP_ORIGIN=
# Independent 32-byte random secret encoded as 64 hex characters; backend-only web runtime.
CHECKOUT_SESSION_SECRET=
