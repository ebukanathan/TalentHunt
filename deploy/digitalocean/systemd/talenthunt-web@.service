# REVIEW TEMPLATE. Installed only after resource/configuration approval.
[Unit]
Description=TalentHunt web (%i)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/talenthunt/%i/deployment.approved
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=talenthunt-%i-web
Group=talenthunt-%i-web
WorkingDirectory=/srv/talenthunt/%i/current/apps/web
Environment=NODE_ENV=production
EnvironmentFile=/etc/talenthunt/%i/web.env
ExecStart=/opt/talenthunt-node/bin/node ../../node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/talenthunt/%i/current/apps/web/.next
MemoryAccounting=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
