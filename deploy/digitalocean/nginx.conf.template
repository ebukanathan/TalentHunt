# Review template, not installed. Render only these __PLACEHOLDERS__, leaving
# Nginx $variables intact. Add TLS through Certbot after approved DNS resolves.
# Included from http context (Ubuntu sites-enabled).
limit_req_zone $binary_remote_addr zone=talenthunt_checkout:10m rate=5r/s;
log_format talenthunt '$remote_addr [$time_iso8601] "$request_method $uri $server_protocol" '
                     '$status $body_bytes_sent $request_time';
server {
    listen 80;
    server_name __HOSTNAME__;
    client_max_body_size 6m;
    client_body_timeout 60s;
    limit_req_status 429;
    access_log /var/log/nginx/talenthunt-__ENVIRONMENT__.access.log talenthunt;
    error_log /var/log/nginx/talenthunt-__ENVIRONMENT__.error.log warn;
    __STAGING_NOINDEX_HEADER__
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
    proxy_next_upstream off;
    # Retain hashed assets from the current and previous reviewed releases.
    location ^~ /_next/static/ {
        alias /srv/talenthunt/__ENVIRONMENT__/static/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location = /api/checkout/initialize {
        limit_req zone=talenthunt_checkout burst=20 nodelay;
        proxy_pass http://127.0.0.1:3000;
    }
    location = /api/checkout/status {
        limit_req zone=talenthunt_checkout burst=20 nodelay;
        proxy_pass http://127.0.0.1:3000;
    }
    location ^~ /api/v1/payments/ {
        limit_req zone=talenthunt_checkout burst=20 nodelay;
        proxy_pass http://127.0.0.1:4000;
    }
    location ^~ /api/v1/ { proxy_pass http://127.0.0.1:4000; }
    # /api/admin and /api/checkout/session stay on the existing Next facade.
    location / { proxy_buffering off; proxy_pass http://127.0.0.1:3000; }
}
