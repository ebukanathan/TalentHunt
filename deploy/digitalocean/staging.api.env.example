# Private file: /etc/talenthunt/staging/api.env, root:root 0600. Not an active dotenv file.
NODE_ENV=production
DEPLOYMENT_ENV=staging
API_BIND_HOST=127.0.0.1
PORT=4000
STAGING_APP_ORIGIN=https://staging-talent.apearlschools.com
STAGING_DATABASE_APPROVED=false
STAGING_SUPABASE_PROJECT_REF=
# Private approved project session-pooler URL: 5432, /postgres,
# sslmode=require&sslaccept=strict&connection_limit=5&pool_timeout=10.
DATABASE_URL=
PUBLIC_COMPETITION_SLUG=talenthunt-demo
ADMIN_AUTH_ENABLED=true
ADMIN_APP_ORIGIN=https://staging-talent.apearlschools.com
ADMIN_CSRF_SECRET=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://staging-talent.apearlschools.com/payments/return
PAYSTACK_LIVE_ACTIVATION_APPROVED=false
# Enable these together only after the approved target, migrations and signing keys.
PAYSTACK_FINALIZATION_ENABLED=false
PAYSTACK_WEBHOOKS_ENABLED=false
PAYSTACK_WEBHOOK_SIGNING_KEYS=
PAYSTACK_ALLOW_LEGACY_SIGNATURE=false
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_SENDER_VERIFIED=false
EMAIL_FROM=
EMAIL_TEST_RECIPIENTS=
EMAIL_MAX_ATTEMPTS=8
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
