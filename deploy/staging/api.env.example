# TEMPLATE ONLY. Private Render environment group: talenthunt-staging-api.
# Do not copy an existing worktree's environment file into staging.
NODE_ENV=production
DEPLOYMENT_ENV=staging
# Set true ONLY after independently confirming the new isolated project identity.
STAGING_DATABASE_APPROVED=false
STAGING_SUPABASE_PROJECT_REF=APPROVED_STAGING_PROJECT_REF
# Copy session-pooler hostname from Supabase Connect; do not guess it.
# DATABASE_URL must use postgres.PROJECT_REF, password, port 5432, /postgres,
# sslmode=require&sslaccept=strict; optional connection_limit=5&pool_timeout=10.
# Enter privately; never disable certificate checks to resolve connectivity.
DATABASE_URL=
PUBLIC_COMPETITION_SLUG=talenthunt-demo
ADMIN_AUTH_ENABLED=true
ADMIN_APP_ORIGIN=https://VERCEL_ASSIGNED_STAGING_HOST
ADMIN_CSRF_SECRET=
ADMIN_IDLE_MINUTES=30
ADMIN_ABSOLUTE_HOURS=8
SUPABASE_URL=https://APPROVED_STAGING_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://VERCEL_ASSIGNED_STAGING_HOST/payments/return
# Leave off until secrets, isolated database, migrations and worker are ready.
PAYSTACK_FINALIZATION_ENABLED=false
PAYSTACK_WEBHOOKS_ENABLED=false
# Private JSON array of {"id":"whk_...","secret":"whsec_..."} from TEST dashboard.
PAYSTACK_WEBHOOK_SIGNING_KEYS=
PAYSTACK_ALLOW_LEGACY_SIGNATURE=false
PAYSTACK_WEBHOOK_MAX_ATTEMPTS=8
# Render assigns PORT. Do not override it or add live credentials.
